# Application Settings
APP_NAME=Workout Form Coach
APP_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Settings
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/workout_form_coach

# Google OAuth & Session Security
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
SESSION_SECRET=

# Video and Ingestion Settings
MEDIA_ROOT=media
MAX_VIDEO_SIZE_MB=100
MAX_VIDEO_DURATION_SECONDS=60
YOUTUBE_DOWNLOAD_TIMEOUT_SECONDS=120

# Background Worker Settings
WORKER_POLL_INTERVAL_SECONDS=2
PROCESSING_FPS=15

# MediaPipe Pose Settings
POSE_MODEL_PATH=app/models/assets/pose_landmarker_lite.task
POSE_MIN_DETECTION_CONFIDENCE=0.5
POSE_MIN_TRACKING_CONFIDENCE=0.5

# Biomechanics & Smoothing Settings
LANDMARK_SMOOTHING_ALPHA=0.5
LANDMARK_VISIBILITY_THRESHOLD=0.5

# Rep Counting Thresholds (degrees)
SQUAT_UP_ANGLE=160
SQUAT_DOWN_ANGLE=100
PUSHUP_UP_ANGLE=160
PUSHUP_DOWN_ANGLE=90
LUNGE_UP_ANGLE=160
LUNGE_DOWN_ANGLE=100

# Form Analysis Settings
SQUAT_DEPTH_ANGLE=100
PUSHUP_DEPTH_ANGLE=90
LUNGE_DEPTH_ANGLE=100
KNEE_ASYMMETRY_THRESHOLD=15
ELBOW_ASYMMETRY_THRESHOLD=15
LUNGE_ASYMMETRY_THRESHOLD=15
FORM_WARNING_PENALTY=10
FORM_MAJOR_PENALTY=20



